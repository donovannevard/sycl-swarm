[Unit]
Description=Media Skeptic Digest (local-agent-forge Phase 3 job)
After=network.target llama-swap.service docker.service

[Service]
Type=oneshot
User=svc-agent-forge
Group=svc-agent-forge
Environment=HOME=/var/lib/agent-forge
WorkingDirectory=/var/lib/agent-forge/jobs
ExecStart=/var/lib/agent-forge/venv/bin/python3 /var/lib/agent-forge/jobs/media_digest.py

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-forge
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
